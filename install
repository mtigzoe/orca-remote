#!/usr/bin/env python3

from glob import glob
import json
import os
import re
import shutil
import sys


def replace_setting(text, name, literal):
    """Replace one ``NAME = ...`` settings line; leave other uses alone.

    Rewriting the bare sentinels ("host", "key") used to hit every
    occurrence, including ``type="key"`` in the key-forwarding frames
    and the auto-connect check. Anchor on the assignment line instead.
    """

    pattern = re.compile(r"(?m)^%s = .*$" % re.escape(name))
    replacement = "%s = %s" % (name, literal)
    return pattern.sub(replacement, text, count=1)


def make_orca_customizations(destfile, nvda_remote_host=None, nvda_remote_port=None, nvda_remote_key=None):
    with open("orca-customizations.py", "r") as f:
        customizations = f.read()
    if nvda_remote_host:
        customizations = replace_setting(
            customizations, "YOUR_NVDAREMOTE_SERVER_ADDRESS", json.dumps(str(nvda_remote_host)),
        )
    if nvda_remote_port:
        customizations = replace_setting(
            customizations, "YOUR_NVDAREMOTE_SERVER_PORT", str(int(nvda_remote_port)),
        )
    if nvda_remote_key:
        customizations = replace_setting(
            customizations, "YOUR_NVDAREMOTE_KEY", json.dumps(str(nvda_remote_key)),
        )
    if nvda_remote_host and nvda_remote_key:
        customizations = customizations.replace(
            "ORCA_REMOTE_AUTO_CONNECT = False",
            "ORCA_REMOTE_AUTO_CONNECT = True",
        )
    with open(destfile, "w") as f2:
        f2.write(customizations)


def main():
    orca_folder = os.path.expanduser("~/.local/share/orca")
    orca_scripts_folder = os.path.join(orca_folder, "orca-scripts")
    print("This installs the legacy Orca Remote customization path.")
    print("For modern Orca versions, prefer: ./build-orca-ext.sh . && orca --install-extension remote.orca-ext")
    input("Installing legacy Orca Remote to %s. Press Enter to continue or Ctrl+C to abort:" % orca_folder)

    customizations_path = os.path.join(orca_folder, "orca-customizations.py")
    if os.path.exists(customizations_path):
        print("Backing up your orca-customizations...")
        shutil.copy(customizations_path, "%s/orca-customizations-backup.py" % orca_folder)

    print("Creating customizations...")
    if len(sys.argv) >= 4:
        make_orca_customizations(customizations_path, sys.argv[1], sys.argv[2], sys.argv[3])
    else:
        make_orca_customizations(customizations_path)

    print("Copying Orca Remote libraries...")
    os.makedirs(orca_scripts_folder, exist_ok=True)
    for file in glob("orca-scripts/*.py"):
        shutil.copy(file, os.path.join(orca_folder, file))

    print("")
    print("Legacy installation complete. Restart Orca with: orca --replace")
    print("")
    if len(sys.argv) >= 4:
        print("Auto-connect is configured. Orca will connect on startup.")
    else:
        print("No server configured. Use the connect dialog after Orca starts:")
        print("  Orca+Alt+PageUp  to open the connect dialog")
    print("")
    print("Gestures (Orca key = Insert or CapsLock):")
    print("  Orca+Alt+Tab        = Toggle local/remote control")
    print("  Orca+Alt+PageUp     = Connect dialog")
    print("  Orca+Alt+PageDown   = Disconnect")
    print("  Ctrl+Shift+Orca+C   = Push clipboard to remote")
    print("  Orca+Alt+M          = Mute/unmute remote")
    print("  Orca+Shift+Delete   = Send Ctrl+Alt+Del to remote")
    print("")
    print("Optional dependencies:")
    print("  sudo apt install xdotool   # X11 remote key injection")
    print("  sudo apt install ydotool   # Optional Wayland fallback if configured")
    print("  sudo apt install sox       # For tone playback")
    print("  sudo apt install xclip     # Clipboard fallback")
    print("")
    print("GNOME Wayland key injection uses the XDG Remote Desktop portal.")
    print("Approve the keyboard-control prompt when the first remote key arrives.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
